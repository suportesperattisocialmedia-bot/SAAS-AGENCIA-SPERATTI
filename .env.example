# GABRIEL SPERATTI | SOCIAL INTELLIGENCE
# Copie para .env (desenvolvimento local) ou cadastre em Vercel > Settings > Environment Variables.
# Todas as variáveis são lidas APENAS no backend (/api). Nenhuma usa prefixo VITE_.

# IA (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Meta / Instagram (Facebook Login for Business)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://saas-agencia-speratti.vercel.app/api/auth/instagram/callback
# Opcional: versão da Graph API (padrão v23.0)
META_GRAPH_VERSION=

# Sessão + criptografia de tokens (mínimo 32 caracteres aleatórios)
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Opcional: chave dedicada para criptografar tokens OAuth (padrão: derivada de SESSION_SECRET)
TOKEN_ENCRYPTION_KEY=

# PostgreSQL (Supabase). Use a connection string do pooler (Supavisor, porta 6543).
DATABASE_URL=
# Opcional: disable | verify (padrão: TLS sem verificação de CA, como recomendado pelo pooler)
DATABASE_SSL=

# Opcional: cria o primeiro usuário (owner) no primeiro login se o banco não tiver nenhum usuário.
# Remova após o primeiro acesso.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
AGENCY_NAME=

# Opcional: pesquisa externa real (público e concorrentes). Sem ela, a UI informa "não configurada".
SERPAPI_KEY=
