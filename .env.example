# GABRIEL SPERATTI | SOCIAL INTELLIGENCE
# Application Environment Configuration Template

# Gemini AI API Configuration
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"

# Meta Graph API / Instagram Integration (Server-Side Only)
META_APP_ID="YOUR_META_APP_ID"
META_APP_SECRET="YOUR_META_APP_SECRET"
META_REDIRECT_URI="https://your-domain.com/api/integrations/instagram/callback"

# Application URL (Auto-injected in AI Studio at runtime)
APP_URL="http://localhost:3000"

# Security & Session Secrets
SESSION_SECRET="your_secure_random_session_secret_min_32_chars"

# Database & Storage (Optional: for Supabase / PostgreSQL migration)
DATABASE_URL="postgresql://user:password@localhost:5432/gs_intelligence"

# Environment Mode
NODE_ENV="development"
